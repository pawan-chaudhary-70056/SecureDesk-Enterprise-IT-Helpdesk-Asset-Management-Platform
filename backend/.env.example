PORT=3001
NODE_ENV=development

# SQLite for local dev (no external services needed).
DATABASE_URL="file:./dev.db"
# PostgreSQL example for production:
# DATABASE_URL=postgresql://securedesk:password@localhost:5432/securedesk

# Set to enable BullMQ-backed queues (falls back to in-process workers when empty)
# REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=60

FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
AUTH_RATE_LIMIT_PER_MIN=20
