# Root environment (used by docker-compose). Copy to .env and adjust.
NODE_ENV=production

POSTGRES_USER=securedesk
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=securedesk

# Backend
DATABASE_URL=postgresql://securedesk:change-me-strong-password@postgres:5432/securedesk
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
FRONTEND_ORIGIN=http://localhost:5173
